FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[dev]" || pip install --no-cache-dir \
    fastapi uvicorn curl-cffi python-dotenv tqdm chromadb beautifulsoup4 ollama numpy slowapi requests

COPY src/ src/
COPY api/ api/
COPY main.py .

ENV OLLAMA_HOST=http://ollama:11434

CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8000"]
